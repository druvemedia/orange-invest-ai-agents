# Copy to .env and fill in locally. Never commit .env.

APP_NAME="Orange Invest AI Agent"
# One of: development, test, production
APP_ENV=development
LOG_LEVEL=INFO

# LLM settings. Only needed to run the agents against a real model; tests never use them.
# LLM_PROVIDER: "openai" is the only supported value.
LLM_PROVIDER=
# A model that supports structured outputs via the Responses API.
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4000

# Investigation limits
AGENT_MAX_CRITIC_ROUNDS=2
AGENT_MAX_EVIDENCE_REQUESTS=3
INVESTIGATION_DEADLINE_SECONDS=300
