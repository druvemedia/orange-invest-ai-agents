# Copy to .env and fill in locally. Never commit .env.

APP_NAME="Orange Invest AI Agent"
# One of: development, test, production
APP_ENV=development
LOG_LEVEL=INFO

# LLM settings. Only needed to run the agents against a real model; tests never use them.
# LLM_PROVIDER: "openai" (real model, billed) or "offline-heuristic" (keyless rule-based demo stand-in,
# NOT an AI model; every report says so). Left empty, the API runs but investigations return 503.
LLM_PROVIDER=
# A model that supports structured outputs via the Responses API.
LLM_MODEL=
LLM_API_KEY=
# Per-request model timeout in seconds (> 0, max 600). Each agent attempt is also bounded by the
# engine at this value + 30 s, and INVESTIGATION_DEADLINE_SECONDS must be at least that. A timed-out
# request is retried at most once per agent task.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=4000

# Investigation limits
AGENT_MAX_CRITIC_ROUNDS=2
AGENT_MAX_EVIDENCE_REQUESTS=3
INVESTIGATION_DEADLINE_SECONDS=300
# Investigations the API runs at once (1-10); further submissions get HTTP 429.
API_MAX_ACTIVE_INVESTIGATIONS=2
